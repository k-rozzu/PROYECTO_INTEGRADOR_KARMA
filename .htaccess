# Bloquea el acceso desde el navegador a los archivos con claves (.env, .env.example) en cualquier carpeta del proyecto
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Bloquea la descarga directa de los archivos de Composer
<FilesMatch "^composer\.(json|lock)$">
    Require all denied
</FilesMatch>

# Bloquea la descarga del lanzador y la politica del tunel de ngrok
<FilesMatch "^(ngrok_mercadopago\.yml|iniciar_tunel_mercadopago\.bat)$">
    Require all denied
</FilesMatch>
